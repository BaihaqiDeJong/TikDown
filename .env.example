# Server
PORT=3000

# Provider: "tikwm" (default, gratis, tanpa API key) atau "rapidapi"
TIKTOK_PROVIDER=tikwm

# Wajib hanya jika TIKTOK_PROVIDER=rapidapi
RAPIDAPI_KEY=
RAPIDAPI_HOST=tiktok-scraper7.p.rapidapi.com

# Batas waktu request ke provider (ms)
API_TIMEOUT_MS=15000

# Opsional: path binary ffmpeg sendiri. Kosongkan untuk memakai ffmpeg-static.
FFMPEG_PATH=
